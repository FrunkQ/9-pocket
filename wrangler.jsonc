  // Cloudflare Workers: serves the built app in ./dist as static files.
  // Build command: npm run build   Deploy command: npx wrangler deploy
  "name": "9-pocket",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
